{
  "name": "@dormeto/operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --external:@aws-sdk/* && esbuild src/check.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/check.mjs --external:@aws-sdk/*"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-ec2": "^3.1146.0",
    "@aws-sdk/client-eks": "^3.1149.0",
    "@aws-sdk/client-eventbridge": "^3.1146.0",
    "@aws-sdk/client-iam": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-scheduler": "^3.1146.0",
    "@aws-sdk/client-sfn": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dormeto/discovery": "*"
  }
}
