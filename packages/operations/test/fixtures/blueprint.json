{
  "router": {
    "name": "${name}",
    "region": "${region}",
    "account": "${account}",
    "version": "0.24.0",
    "build": "45f7f87bb8d8"
  },
  "tags": {
    "dormeto:router": "${name}"
  },
  "roles": [
    {
      "key": "controller",
      "path": "/dormeto/router/",
      "name": "${name}-${region}-controller",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "policyName": "controller",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dynamodb:GetItem",
              "dynamodb:UpdateItem",
              "dynamodb:Scan",
              "dynamodb:Query",
              "dynamodb:DeleteItem"
            ],
            "Resource": [
              "arn:${partition}:dynamodb:${region}:${account}:table/${name}-router"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "ec2:DescribeInstances",
              "elasticloadbalancing:DescribeRules",
              "elasticloadbalancing:DescribeTargetHealth",
              "elasticloadbalancing:DescribeTargetGroups",
              "elasticloadbalancing:DescribeListeners",
              "elasticloadbalancing:DescribeTags",
              "cloudwatch:GetMetricData",
              "lambda:GetAccountSettings"
            ],
            "Resource": [
              "*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "ec2:StartInstances",
              "ec2:StopInstances"
            ],
            "Resource": [
              "arn:${partition}:ec2:${region}:${account}:instance/*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:ModifyRule"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener-rule/app/*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "cognito-idp:DescribeUserPoolClient"
            ],
            "Resource": [
              "arn:${partition}:cognito-idp:${region}:${account}:userpool/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "autoscaling:DescribeAutoScalingGroups",
              "tag:GetResources",
              "ecs:DescribeServices",
              "application-autoscaling:DescribeScalableTargets",
              "rds:DescribeDBInstances",
              "rds:DescribeDBClusters"
            ],
            "Resource": [
              "*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "rds:StartDBInstance",
              "rds:StopDBInstance",
              "rds:StartDBCluster",
              "rds:StopDBCluster"
            ],
            "Resource": [
              "arn:${partition}:rds:${region}:${account}:db:*",
              "arn:${partition}:rds:${region}:${account}:cluster:*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "ecs:UpdateService"
            ],
            "Resource": [
              "arn:${partition}:ecs:${region}:${account}:service/*/*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "application-autoscaling:RegisterScalableTarget"
            ],
            "Resource": [
              "arn:${partition}:application-autoscaling:${region}:${account}:scalable-target/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "autoscaling:UpdateAutoScalingGroup",
              "autoscaling:SuspendProcesses",
              "autoscaling:ResumeProcesses"
            ],
            "Resource": [
              "arn:${partition}:autoscaling:${region}:${account}:autoScalingGroup:*:autoScalingGroupName/*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              "arn:${partition}:lambda:${region}:${account}:function:${name}-controller",
              "arn:${partition}:lambda:${region}:${account}:function:${name}-onboarder"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage"
            ],
            "Resource": [
              "arn:${partition}:sqs:${region}:${account}:${name}-controller-failures",
              "arn:${partition}:sqs:${region}:${account}:${name}-work",
              "arn:${partition}:sqs:${region}:${account}:${name}-drift"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:GetQueueAttributes",
              "sqs:ChangeMessageVisibility"
            ],
            "Resource": [
              "arn:${partition}:sqs:${region}:${account}:${name}-work"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:GetQueueAttributes"
            ],
            "Resource": [
              "arn:${partition}:sqs:${region}:${account}:${name}-controller-failures",
              "arn:${partition}:sqs:${region}:${account}:${name}-check-failures"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "events:PutEvents"
            ],
            "Resource": [
              "${managerBus}"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": [
              "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/${name}-controller:*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject"
            ],
            "Resource": [
              "arn:${partition}:s3:::${ipListsBucket}/*"
            ]
          }
        ]
      }
    },
    {
      "key": "waker",
      "path": "/dormeto/router/",
      "name": "${name}-${region}-waker",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "policyName": "waker",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dynamodb:GetItem",
              "dynamodb:UpdateItem",
              "dynamodb:Query"
            ],
            "Resource": [
              "arn:${partition}:dynamodb:${region}:${account}:table/${name}-router"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              "arn:${partition}:lambda:${region}:${account}:function:${name}-controller"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "events:PutEvents"
            ],
            "Resource": [
              "${managerBus}"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": [
              "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/${name}-waker:*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "s3:GetObject"
            ],
            "Resource": [
              "arn:${partition}:s3:::${ipListsBucket}/*"
            ]
          }
        ]
      }
    },
    {
      "key": "scheduler",
      "path": "/dormeto/router/",
      "name": "${name}-${region}-scheduler",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "scheduler.amazonaws.com"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "aws:SourceAccount": "${account}"
              },
              "ArnEquals": {
                "aws:SourceArn": "arn:${partition}:scheduler:${region}:${account}:schedule-group/default"
              }
            }
          }
        ]
      },
      "policyName": "scheduler",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              "arn:${partition}:lambda:${region}:${account}:function:${name}-controller"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage"
            ],
            "Resource": [
              "arn:${partition}:sqs:${region}:${account}:${name}-check-failures"
            ]
          }
        ]
      }
    },
    {
      "key": "onboarder",
      "path": "/dormeto/router/",
      "name": "${name}-${region}-onboarder",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "policyName": "onboarder",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "dynamodb:GetItem",
              "dynamodb:UpdateItem",
              "dynamodb:Query",
              "dynamodb:Scan",
              "dynamodb:DeleteItem"
            ],
            "Resource": [
              "arn:${partition}:dynamodb:${region}:${account}:table/${name}-router"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:DescribeTargetGroups",
              "elasticloadbalancing:DescribeListeners",
              "elasticloadbalancing:DescribeRules",
              "elasticloadbalancing:DescribeTags",
              "elasticloadbalancing:DescribeTargetHealth",
              "elasticloadbalancing:DescribeAccountLimits",
              "ec2:DescribeInstances",
              "autoscaling:DescribeAutoScalingGroups",
              "ecs:ListClusters",
              "ecs:ListServices",
              "ecs:DescribeServices",
              "rds:DescribeDBInstances",
              "rds:DescribeDBClusters"
            ],
            "Resource": [
              "*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:CreateTargetGroup",
              "elasticloadbalancing:ModifyTargetGroupAttributes",
              "elasticloadbalancing:DeleteTargetGroup",
              "elasticloadbalancing:RegisterTargets",
              "elasticloadbalancing:DeregisterTargets"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:targetgroup/${name}-*/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:ModifyRule"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener-rule/app/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "cognito-idp:DescribeUserPoolClient"
            ],
            "Resource": [
              "arn:${partition}:cognito-idp:${region}:${account}:userpool/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:CreateRule"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener/app/*",
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener-rule/app/*"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:DeleteRule",
              "elasticloadbalancing:SetRulePriorities"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener-rule/app/*"
            ],
            "Condition": {
              "Null": {
                "aws:ResourceTag/dormeto:workload": "false"
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "elasticloadbalancing:AddTags",
              "elasticloadbalancing:RemoveTags"
            ],
            "Resource": [
              "arn:${partition}:elasticloadbalancing:${region}:${account}:listener-rule/app/*",
              "arn:${partition}:elasticloadbalancing:${region}:${account}:targetgroup/${name}-*/*"
            ],
            "Condition": {
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "dormeto:workload",
                  "dormeto:tagged",
                  "dormeto:router",
                  "dormeto:shadows"
                ]
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "ec2:CreateTags",
              "ec2:DeleteTags",
              "autoscaling:CreateOrUpdateTags",
              "autoscaling:DeleteTags",
              "ecs:TagResource",
              "ecs:UntagResource",
              "rds:AddTagsToResource",
              "rds:RemoveTagsFromResource"
            ],
            "Resource": [
              "arn:${partition}:ec2:${region}:${account}:instance/*",
              "arn:${partition}:autoscaling:${region}:${account}:autoScalingGroup:*:autoScalingGroupName/*",
              "arn:${partition}:ecs:${region}:${account}:service/*/*",
              "arn:${partition}:rds:${region}:${account}:db:*",
              "arn:${partition}:rds:${region}:${account}:cluster:*"
            ],
            "Condition": {
              "ForAllValues:StringEquals": {
                "aws:TagKeys": [
                  "dormeto:workload",
                  "dormeto:tagged",
                  "dormeto:router",
                  "dormeto:shadows"
                ]
              }
            }
          },
          {
            "Effect": "Allow",
            "Action": [
              "lambda:RemovePermission"
            ],
            "Resource": [
              "arn:${partition}:lambda:${region}:${account}:function:${name}-waker"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:GetQueueAttributes",
              "sqs:ChangeMessageVisibility"
            ],
            "Resource": [
              "arn:${partition}:sqs:${region}:${account}:${name}-drift"
            ]
          },
          {
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": [
              "arn:${partition}:logs:${region}:${account}:log-group:/aws/lambda/${name}-onboarder:*"
            ]
          }
        ]
      }
    }
  ],
  "table": {
    "name": "${name}-router",
    "hashKey": "pk",
    "rangeKey": "sk",
    "ttlAttribute": "expiresAt",
    "pointInTimeRecovery": true
  },
  "queues": [
    {
      "key": "check-failures",
      "name": "${name}-check-failures",
      "retentionSeconds": 1209600,
      "managedEncryption": true
    },
    {
      "key": "controller-failures",
      "name": "${name}-controller-failures",
      "retentionSeconds": 1209600,
      "managedEncryption": true
    },
    {
      "key": "work",
      "name": "${name}-work",
      "retentionSeconds": 345600,
      "managedEncryption": true,
      "visibilityTimeoutSeconds": 960,
      "deadLetter": {
        "queue": "arn:${partition}:sqs:${region}:${account}:${name}-controller-failures",
        "maxReceiveCount": 3
      }
    },
    {
      "key": "drift",
      "name": "${name}-drift",
      "retentionSeconds": 86400,
      "managedEncryption": true,
      "visibilityTimeoutSeconds": 360,
      "deadLetter": {
        "queue": "arn:${partition}:sqs:${region}:${account}:${name}-controller-failures",
        "maxReceiveCount": 3
      },
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "events.amazonaws.com"
            },
            "Action": "sqs:SendMessage",
            "Resource": "arn:${partition}:sqs:${region}:${account}:${name}-drift",
            "Condition": {
              "ArnEquals": {
                "aws:SourceArn": "arn:${partition}:events:${region}:${account}:rule/${name}-drift"
              }
            }
          }
        ]
      }
    }
  ],
  "logGroups": [
    {
      "name": "/aws/lambda/${name}-controller",
      "retentionDays": 14
    },
    {
      "name": "/aws/lambda/${name}-waker",
      "retentionDays": 14
    },
    {
      "name": "/aws/lambda/${name}-onboarder",
      "retentionDays": 14
    }
  ],
  "functions": [
    {
      "key": "controller",
      "name": "${name}-controller",
      "role": "${name}-${region}-controller",
      "handler": "controller.handler",
      "timeout": 900,
      "memory": 256,
      "environment": {
        "DMT_TABLE": "${name}-router",
        "DMT_TG_PREFIX": "${name}-",
        "DMT_VERSION": "0.24.0",
        "DMT_BUILD": "45f7f87bb8d8",
        "DMT_IP_LISTS": "${ipLists}",
        "DMT_IP_LISTS_CATALOG": "${ipListsCatalog}",
        "DMT_NO_WAKE_RULES": "${noWakeRules}",
        "DMT_CHECK_SCHEDULE": "${checkSchedule}",
        "DMT_METRICS": "${metrics}",
        "DMT_WAKER_FUNCTION": "${name}-waker",
        "DMT_FAILURE_QUEUES": "{\"check\":\"https://sqs.${region}.amazonaws.com/${account}/${name}-check-failures\",\"controller\":\"https://sqs.${region}.amazonaws.com/${account}/${name}-controller-failures\"}",
        "DMT_ONBOARDER": "${name}-onboarder",
        "DMT_MANAGER_BUS": "${managerBus}",
        "DMT_WORK_QUEUE": "https://sqs.${region}.amazonaws.com/${account}/${name}-work",
        "DMT_DRIFT_QUEUE": "https://sqs.${region}.amazonaws.com/${account}/${name}-drift"
      },
      "asyncInvoke": {
        "maximumRetryAttempts": 0,
        "maximumEventAgeInSeconds": 120,
        "onFailure": "arn:${partition}:sqs:${region}:${account}:${name}-controller-failures"
      },
      "roleArn": "arn:${partition}:iam::${account}:role/dormeto/router/${name}-${region}-controller",
      "runtime": "nodejs24.x",
      "architectures": [
        "arm64"
      ]
    },
    {
      "key": "waker",
      "name": "${name}-waker",
      "role": "${name}-${region}-waker",
      "handler": "waker.handler",
      "timeout": 70,
      "memory": 512,
      "environment": {
        "DMT_TABLE": "${name}-router",
        "DMT_TG_PREFIX": "${name}-",
        "DMT_VERSION": "0.24.0",
        "DMT_BUILD": "45f7f87bb8d8",
        "DMT_CONTROLLER": "${name}-controller",
        "DMT_NO_WAKE_RULES": "${noWakeRules}",
        "DMT_METRICS": "${metrics}",
        "DMT_IP_LISTS": "${ipLists}",
        "DMT_IP_LISTS_CATALOG": "${ipListsCatalog}",
        "DMT_MANAGER_BUS": "${managerBus}"
      },
      "roleArn": "arn:${partition}:iam::${account}:role/dormeto/router/${name}-${region}-waker",
      "runtime": "nodejs24.x",
      "architectures": [
        "arm64"
      ]
    },
    {
      "key": "onboarder",
      "name": "${name}-onboarder",
      "role": "${name}-${region}-onboarder",
      "handler": "onboarder.handler",
      "timeout": 300,
      "memory": 256,
      "environment": {
        "DMT_TABLE": "${name}-router",
        "DMT_TG_PREFIX": "${name}-",
        "DMT_VERSION": "0.24.0",
        "DMT_BUILD": "45f7f87bb8d8",
        "DMT_WAKER_FUNCTION": "${name}-waker",
        "DMT_WAKER_FUNCTION_ARN": "arn:${partition}:lambda:${region}:${account}:function:${name}-waker"
      },
      "roleArn": "arn:${partition}:iam::${account}:role/dormeto/router/${name}-${region}-onboarder",
      "runtime": "nodejs24.x",
      "architectures": [
        "arm64"
      ]
    }
  ],
  "wakerPermission": {
    "function": "${name}-waker",
    "statementId": "dormeto-alb",
    "principal": "elasticloadbalancing.amazonaws.com",
    "sourceArn": "arn:${partition}:elasticloadbalancing:${region}:${account}:targetgroup/${name}-*/*"
  },
  "eventRule": {
    "name": "${name}-drift",
    "pattern": "{\"detail-type\":[\"AWS API Call via CloudTrail\"],\"$or\":[{\"source\":[\"aws.elasticloadbalancing\"],\"detail\":{\"eventName\":[\"ModifyRule\",\"CreateRule\",\"DeleteRule\",\"SetRulePriorities\",\"DeleteTargetGroup\"],\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":\"arn:${partition}:sts::${account}:assumed-role/${name}-\"}}]},\"errorCode\":[{\"exists\":false}]}},{\"source\":[\"aws.elasticloadbalancing\"],\"detail\":{\"eventName\":[\"RemoveTags\"],\"requestParameters\":{\"tagKeys\":[\"dormeto:workload\"]},\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":\"arn:${partition}:sts::${account}:assumed-role/${name}-\"}}]},\"errorCode\":[{\"exists\":false}]}},{\"source\":[\"aws.ec2\"],\"detail\":{\"eventName\":[\"DeleteTags\"],\"requestParameters\":{\"tagSet\":{\"items\":{\"key\":[\"dormeto:workload\"]}}},\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":\"arn:${partition}:sts::${account}:assumed-role/${name}-\"}}]},\"errorCode\":[{\"exists\":false}]}},{\"source\":[\"aws.autoscaling\"],\"detail\":{\"eventName\":[\"DeleteTags\"],\"requestParameters\":{\"tags\":{\"key\":[\"dormeto:workload\"]}},\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":\"arn:${partition}:sts::${account}:assumed-role/${name}-\"}}]},\"errorCode\":[{\"exists\":false}]}},{\"source\":[\"aws.ecs\",\"aws.rds\"],\"detail\":{\"eventName\":[\"UntagResource\",\"RemoveTagsFromResource\"],\"requestParameters\":{\"tagKeys\":[\"dormeto:workload\"]},\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":\"arn:${partition}:sts::${account}:assumed-role/${name}-\"}}]},\"errorCode\":[{\"exists\":false}]}}]}",
    "target": "arn:${partition}:sqs:${region}:${account}:${name}-drift",
    "description": "Dormeto: rules, target groups and workload tags changed outside the router"
  },
  "eventSourceMappings": [
    {
      "key": "work",
      "function": "${name}-controller",
      "queue": "arn:${partition}:sqs:${region}:${account}:${name}-work",
      "batchSize": 1,
      "maximumBatchingWindowSeconds": 0,
      "maximumConcurrency": 10,
      "reportBatchItemFailures": true
    },
    {
      "key": "drift",
      "function": "${name}-onboarder",
      "queue": "arn:${partition}:sqs:${region}:${account}:${name}-drift",
      "batchSize": 100,
      "maximumBatchingWindowSeconds": 60,
      "maximumConcurrency": 2,
      "reportBatchItemFailures": true
    }
  ],
  "schedule": {
    "name": "${name}-check",
    "expression": "${checkSchedule}",
    "target": "arn:${partition}:lambda:${region}:${account}:function:${name}-controller",
    "roleArn": "arn:${partition}:iam::${account}:role/dormeto/router/${name}-${region}-scheduler",
    "input": "{\"action\":\"check\",\"source\":\"schedule\"}",
    "deadLetter": "arn:${partition}:sqs:${region}:${account}:${name}-check-failures",
    "maximumRetryAttempts": 0
  },
  "forwarder": {
    "role": {
      "name": "${name}-forwarder",
      "path": "/dormeto/router/",
      "tags": {
        "dormeto:router": "${name}"
      },
      "policyName": "forwarder",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "events.amazonaws.com"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "aws:SourceAccount": "${account}"
              }
            }
          }
        ]
      },
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": [
              "events:PutEvents"
            ],
            "Resource": [
              "${managerBus}"
            ]
          }
        ]
      }
    },
    "rule": {
      "name": "${name}-discovery",
      "pattern": "{\"source\":[\"aws.elasticloadbalancing\"],\"detail-type\":[\"AWS API Call via CloudTrail\"],\"detail\":{\"eventName\":[\"CreateLoadBalancer\",\"DeleteLoadBalancer\",\"CreateListener\",\"ModifyListener\",\"DeleteListener\",\"CreateRule\",\"ModifyRule\",\"DeleteRule\",\"SetRulePriorities\",\"CreateTargetGroup\",\"ModifyTargetGroup\",\"DeleteTargetGroup\",\"AddTags\",\"RemoveTags\"],\"userIdentity\":{\"arn\":[{\"anything-but\":{\"prefix\":[\"arn:${partition}:sts::${account}:assumed-role/dmtr-\",\"arn:${partition}:sts::${account}:assumed-role/dmt-\",\"arn:${partition}:sts::${account}:assumed-role/${commandRole}/\"]}}]},\"errorCode\":[{\"exists\":false}]}}",
      "targetBus": "${managerBus}",
      "roleArn": "arn:${partition}:iam::${account}:role/dormeto/router/${name}-forwarder",
      "description": "Dormeto: load balancer changes, to the manager's discovery"
    }
  }
}
