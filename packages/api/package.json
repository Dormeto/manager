{
  "name": "@dormeto/manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --external:@aws-sdk/* && esbuild src/watchdog-handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/watchdog.mjs --external:@aws-sdk/*"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/client-sfn": "^3.1146.0",
    "@aws-sdk/client-sns": "^3.1146.0",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dormeto/discovery": "*",
    "@dormeto/operations": "*",
    "@dormeto/fleet": "*"
  }
}
