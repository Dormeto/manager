{
  "name": "@dormeto/fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./description": "./src/description.ts",
    "./energy": "./src/energy.ts",
    "./clouds": "./src/clouds.ts",
    "./registry": "./src/registry.ts",
    "./router-call": "./src/router-call.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --main-fields=module,main --outfile=dist/index.mjs --external:@aws-sdk/*"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dormeto/google": "*"
  }
}
