{
  "name": "@dormeto/manager",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/discovery",
    "packages/fleet",
    "packages/api",
    "packages/operations",
    "packages/dashboard"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs scripts/release/*.test.mjs scripts/parity/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "artifacts": "node scripts/release/artifacts.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/credential-providers": "^3.1146.0"
  },
  "dormeto": {
    "router": "0.30.0",
    "minCli": "0.2.0"
  }
}
